{
  "manifest_version": 2,
  "name": "Bulkhead TZ",
  "version": "1.1.0",
  "description": "Bulkhead's fail-closed per-container Mullvad exits, plus per-container timezone matching: each container's pages present the IANA zone of the exit they are proven to use. Based on Bulkhead by S4N-T0S (GPL-3.0). Unofficial, not by Mullvad AB.",
  "author": "S4N-T0S (Bulkhead); Bulkhead TZ contributors",
  "homepage_url": "https://github.com/S4N-T0S/Bulkhead",

  "browser_specific_settings": {
    "gecko": {
      "id": "{7a91c4e6-3f52-4d8b-9e07-6c25b8ad41f3}",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "permissions": [
    "<all_urls>",
    "proxy",
    "webRequest",
    "webRequestBlocking",
    "storage",
    "contextualIdentities",
    "cookies",
    "dns",
    "alarms",
    "notifications",
    "privacy",
    "clipboardWrite"
  ],

  "content_security_policy": "script-src 'self'; object-src 'none'",

  "background": {
    "scripts": ["decide.js", "relays.js", "zones.js", "tz-realm.js", "ui/fmt.js", "tz.js", "background.js"],
    "persistent": true
  },

  "browser_action": {
    "default_title": "Bulkhead TZ",
    "default_popup": "popup/popup.html",
    "default_icon": "icons/hatch-dark.svg",
    "theme_icons": [
      { "light": "icons/hatch-light.svg", "dark": "icons/hatch-dark.svg", "size": 16 },
      { "light": "icons/hatch-light.svg", "dark": "icons/hatch-dark.svg", "size": 32 }
    ]
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "icons": {
    "48": "icons/bulkhead.svg",
    "96": "icons/bulkhead.svg"
  }
}
